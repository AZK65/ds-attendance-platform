# Public Google Maps JS API key (used at build time by Next.js).
# Restrict it by HTTP referrer + API in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Bearer token for the read-only assistant API (GET /api/assistant/...).
# Leave empty to disable those routes (they respond 503). Generate one with:
#   openssl rand -hex 32
# Send it only as: Authorization: Bearer <token>
ASSISTANT_API_TOKEN=
