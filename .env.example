# Public Google Maps JS API key (used at build time by Next.js).
# Restrict it by HTTP referrer + API in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Signs the admin session cookie (HMAC). Use a long random value, for example
# `openssl rand -base64 32`. If unset, AUTH_PASSWORD is the signing key and
# changing the password logs every already-upgraded device out.
# Never commit a real value.
ADMIN_SESSION_SECRET=

# Shared secret sent as `x-internal-secret` by this server's own scheduled
# jobs and internal document/certificate fetches. At least 16 characters.
# `openssl rand -base64 32`. If unset or too short, those calls get 401.
# Never commit a real value.
INTERNAL_AUTH_SECRET=
